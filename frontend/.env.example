# Copy to frontend/.env.local only if you need to change a default. No secrets belong here.

# Base URL for API requests. Leave empty in development: requests go to /api on the Vite
# server, which proxies them to the backend.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api requests (development only).
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
